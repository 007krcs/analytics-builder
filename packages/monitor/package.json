{
  "name": "@gridstorm/analytix-monitor",
  "version": "0.1.0",
  "description": "Sentinel — an autonomous streaming monitor for Analytics Builder. Watches a live data window, detects + explains anomalies (spikes, drops, flatlines, threshold breaches, new categories), and posts findings to a webhook with optional LLM enrichment.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["anomaly detection", "streaming", "monitoring", "alerting", "observability", "sentinel"],
  "dependencies": {
    "@gridstorm/analytix-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
