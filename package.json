{
  "name": "analytics-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Drag-and-drop analytics builder powered by GridStorm",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:demo",
    "build:packages": "pnpm -r --filter \"@gridstorm/analytix-*\" --filter \"@tekivex/*\" --workspace-concurrency=1 build",
    "build:demo": "pnpm --filter demo build",
    "dev": "pnpm --filter demo dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r --filter \"@gridstorm/analytix-*\" exec tsc --noEmit",
    "typecheck": "pnpm -r --filter \"@gridstorm/analytix-*\" exec tsc --noEmit",
    "clean": "pnpm -r --parallel exec rm -rf dist"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
